  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.15.23",
    "allure-playwright": "^3.10.2"
  },
  "dependencies": {
    "@faker-js/faker": "^9.9.0",
    "csv-parse": "^5.6.0",
    "faker-js": "^1.0.0",
