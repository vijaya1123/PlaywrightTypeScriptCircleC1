{
  "name": "opencartplaywright",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "postinstall": "npx playwright install",
    "test": "npx playwright test ",
    "test:headed": "npx playwright test --headed ",
    "test:ui": "npx playwright test --grep @ui --headed ",
    "test:master": "npx playwright test --grep @master",
    "test:debug": "playwright test --grep @sanity --debug",
    "test:regression": "playwright test --grep @regression --headed ",
    "test:datadriven": "playwright test --grep @datadriven --headed ",
    "test:master:headed": "playwright test --grep @master --headed",
    "test:end-to-end": "playwright test --grep @end-to-end --headed ",
    "test:sanity:debug": "playwright test --grep @sanity --debug",
      "report:generate": "allure generate reports/allure-results -o reports/allure-report --clean",
    "report:open": "allure open reports/allure-report",
    "report": "npm run report:generate && npm run report:open"

  },
